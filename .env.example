# Port to run the server on (default: 3000)
PORT=3000

# Database Configuration:
# Leave empty to automatically use SQLite (zero-config file database)
# Or supply your PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mtalk

# If your PostgreSQL requires SSL (e.g. AWS RDS / Supabase / Neon):
# PG_SSL=true
